# --- Runtime ---
NODE_ENV=development
APP_NAME=Trag
# PORT=3000

CLIENT_NAME=Dev Client

# --- Our database (separate `trag` DB in the Traccar Postgres instance) ---
# Local dev (dev/compose.yml): postgres://trag:trag@localhost:5432/trag
# Production (inside the gps network): postgres://trag:<password>@db:5432/trag
DATABASE_URL=postgres://trag:trag@localhost:5432/trag

# --- Traccar (internal; never exposed to end users) ---
TRACCAR_URL=http://traccar:8082/api
TRACCAR_TOKEN=
# Alternative to TRACCAR_TOKEN: Basic auth with the service user
# TRACCAR_USER=
# TRACCAR_PASS=

# --- Secrets (generate with: openssl rand -hex 32) ---
WEBHOOK_SECRET=
SESSION_SECRET=

# --- First owner user ---
# Created on startup when the users table is empty, or explicitly with `npm run seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- AI assistant (optional; features disabled when unset) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_SUMMARY_MODEL=claude-haiku-4-5-20251001

# --- Telegram daily summary (optional) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
